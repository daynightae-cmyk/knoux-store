{
  "name": "knoux-digital-headquarters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./tests/isolate-network.mjs --test --disable-warning=ExperimentalWarning tests/*.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=json-summary node --import ./tests/isolate-network.mjs --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=high",
    "audit:dead": "knip",
    "audit:controls": "node scripts/build-controls.mjs",
    "audit:css-integrity": "node scripts/css-integrity.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run audit:css-integrity && npm test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "libphonenumber-js": "^1.13.14",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "knip": "^5.88.1",
    "typescript": "~5.9"
  }
}

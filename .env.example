# Configure a server-side HTTPS webhook for real contact submissions.
CONTACT_WEBHOOK_URL=

# Supabase Auth uses public project credentials. Do not put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key


# Optional KNOuX Signal public-web evidence provider.
# Server-side only. When absent, Signal reports public search as not_configured.
EXA_API_KEY=

# Configure a server-side HTTPS webhook for real contact submissions.
CONTACT_WEBHOOK_URL=

# Supabase Auth uses public project credentials. Do not put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key


# Optional KNOuX Signal public-web evidence provider.
# Server-side only. When absent, Signal reports public search as not_configured.
EXA_API_KEY=


# ---------------------------------------------------------------------------
# Domain availability (the /wordpress Domain Finder)
# ---------------------------------------------------------------------------
# Server-side only. These are registrar credentials and must never be exposed
# through a NEXT_PUBLIC_ variable: the browser asks /api/domain/* and this
# process asks the registrar.
#
# With nothing set, the finder says so on the page and in the result field. That
# is the intended default, not a broken deployment — an availability answer that
# nobody can source is never invented to fill the gap.
#
# Set a provider only when EVERY variable it needs is present. A provider
# missing one credential is treated as absent and reported as partially
# configured, because it would otherwise fail at a visitor's first search.
#
# Exactly one provider is used. WHMCS takes precedence when configured, since a
# reseller surface is set last and is meant to override a direct registrar.
#
# KNOUX_DOMAIN_CLOUDFLARE_ACCOUNT_ID=
# KNOUX_DOMAIN_CLOUDFLARE_TOKEN=
# KNOUX_DOMAIN_NAMECHEAP_API_USER=
# KNOUX_DOMAIN_NAMECHEAP_API_KEY=
# KNOUX_DOMAIN_NAMECHEAP_CLIENT_IP=
# KNOUX_DOMAIN_WHMCS_BASE_URL=
# KNOUX_DOMAIN_WHMCS_API_IDENTIFIER=
# KNOUX_DOMAIN_WHMCS_API_SECRET=
# KNOUX_DOMAIN_WHMCS_AVAILABILITY_URL=
#
# Optional. A comma-separated list of the extensions that account can actually
# register, e.g. KNOUX_DOMAIN_CLOUDFLARE_TLDS=com,net,ae
#
# Leave it unset and the finder checks every extension the visitor asks about.
# Set it, and an extension outside the list is reported as UNSUPPORTED without
# contacting the registrar — because a registrar asked about an extension it does
# not sell answers the same way one that is having a bad minute does, and that
# answer reads exactly like "taken".
#
# Only fill this in if you will maintain it. A list that goes stale can only
# produce a false "unsupported", which is a name the registrar would have
# checked, refused in the interface.
#
# KNOUX_DOMAIN_CLOUDFLARE_TLDS=
# KNOUX_DOMAIN_NAMECHEAP_TLDS=
# KNOUX_DOMAIN_WHMCS_TLDS=


# ---------------------------------------------------------------------------
# KNOuX Store Local Bridge Control Plane
# ---------------------------------------------------------------------------
# Server-only. Required by machine registration / heartbeat / job routing APIs.
# Configure only in the server deployment secret store. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional on the Windows bridge. When unset, outbound control-plane networking
# is completely disabled and the bridge remains loopback-only.
# Bare origin uses the signed Next BFF: https://knoux.store
# A full Edge Function URL is also supported; its path is preserved:
# https://cnkddxxhcfceokxzaaot.supabase.co/functions/v1/knoux-bridge-control
KNOUX_CONTROL_PLANE_URL=
# One-time token from POST /api/build/bridge/control/enroll. Remove it after first successful enrollment.
KNOUX_CONTROL_PLANE_ENROLLMENT_TOKEN=

# ---------------------------------------------------------------------------
# KNOuX Growth / Social Command Center
# ---------------------------------------------------------------------------
# Phase 2 tenant/auth enforcement. Keep false until the Growth migrations are
# applied and the first OWNER membership is bootstrapped server-side.
KNOUX_GROWTH_AUTH_ENFORCED=false
#
# Server-side only. None of these may be exposed through a NEXT_PUBLIC_
# variable, and no value belongs in this file: the browser never receives a
# credential. /api/growth/capabilities projects these as presence counts and
# variable NAMES only.
#
# With nothing set, the Command Center is fully usable and fully reviewable. It
# shows labelled demo fixtures, every connection reads CONFIG_REQUIRED or
# NOT_CONNECTED, and no capability claims LIVE_VERIFIED. That is the intended
# default, not a broken deployment.
#
# KNOuX Intelligence. The KNOuX Agent is the intended primary provider. Without
# an endpoint and token the router serves the local deterministic reasoner and
# labels every answer provisional. Set BOTH to enable the agent.
#
# KNOUX_AGENT_ENDPOINT=https://<agent-engine-a2a-endpoint>
# KNOUX_AGENT_TOKEN=
# KNOUX_AGENT_RESOURCE=
# KNOUX_AGENT_TIMEOUT_MS=30000
#
# Meta. Business credentials, never user tokens. META_APP_ID and META_APP_SECRET
# together enable the eight read capabilities; WHATSAPP_PHONE_NUMBER_ID adds the
# WhatsApp status, template and lead reads.
#
# META_APP_ID=
# META_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
#
# Google Ads. Requires a developer token from an approved manager account in
# addition to the OAuth client pair.
#
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
#
# Google services (Business Profile, Analytics, Search Console, YouTube). One
# OAuth client pair, separate scopes per surface so a grant can stay narrow:
# GA4 read-only does not imply Search Console, and neither implies Ads.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Contact delivery (the one endpoint a customer writes to)
# ---------------------------------------------------------------------------
# A valid enquiry is only accepted when one of these transports exists.
# Without either, /api/contact answers 503 and says the delivery is not
# configured: a site that cannot deliver must not answer "received".
#
# Transport 1 - email (preferred). Server-side only; never NEXT_PUBLIC_.
#   RESEND_API_KEY          API key from resend.com (resend.dev is sandbox).
#   CONTACT_NOTIFY_EMAIL    inbox that receives the enquiry.
#   CONTACT_FROM_EMAIL      verified sender. With resend.dev this must stay
#                           onboarding@resend.dev, which only delivers to the
#                           account owner.
# Transport 2 - webhook. Server-side HTTPS URL that receives the enquiry as
#   JSON. A loopback or plaintext URL is refused by the fetch guard.
#
# Full procedure: docs/contact-delivery-runbook.md
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# Supabase project configuration. Publishable keys are designed for browser use; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://knoux.store

# Configure a server-side HTTPS webhook for real contact submissions.
CONTACT_WEBHOOK_URL=

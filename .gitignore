node_modules/
.next/
.next-*/
out/
.vercel/
*.tsbuildinfo
.env*
!.env.example
npm-debug.log*
.lint-report.json

# Local visual QA artefacts: browser profiles and screenshots from ad-hoc checks.
# Never commit these; they are reproducible from the production server.
.qa-chrome-*/
.qa-*/
qa-*.png
*.png
!public/creative/material-study-v2.png

# Accidental nested checkout of this same repository. It carries its own .git,
# its own node_modules and its own .next, none of which belong in this tree.
/knoux-store/

# Playwright run output: traces, screencasts, failure screenshots, reports.
# Reproducible from `npm run test:e2e`; a trace.zip is megabytes of binary that
# would otherwise be committed on every failing run.
/e2e/.artifacts/

# Ad-hoc verification scratch from closure work: throwaway screenshots and
# server logs from manual one-off checks, superseded by the E2E evidence set.
/audit/verify-now/

# Local tool state.
.autohand/

# The user's own archive. Never tracked, never staged, never touched.
/Knoux Store.rar

scripts/
*.py
!/gateway/*.py
KNOuX_VISUAL_REFERENCES_MASTER.txt
KNOuX_WORK_EXECUTION_PROMPT.txt
New Text Document.txt
public/knoux-particles.bin

# KNOuX Signal local server logs
.signal-server.*

# Build, lint and typecheck provenance written by the ad-hoc proof scripts, plus the
# QA harness and smoke fixtures they drive. Each run overwrites its own files, so they
# are evidence of one local run rather than source. The harness scripts are regenerated
# by hand when a check needs to change.
.signal-*.log
.signal-*.code
.signal-*.err
.signal-*.cmd
.signal-*.ps1
.signal-*.mjs
.signal-normalize-smoke.*

# Screenshots and QA result JSON from manual visual passes. Reproducible from the
# running server; the PNG pattern above already covers the images.
/audit/

# Supabase CLI scratch (link state, cached project ids).
/supabase/.temp/

# KNOuX Signal ingestion pipeline is tracked; other legacy scripts remain ignored.
!/scripts/
/scripts/*
!/scripts/css-integrity.mjs
!/scripts/css-integrity-matrix.mjs
!/scripts/signal/
!/scripts/signal/**
!/scripts/signal/*.py
.venv-signal/
.venv-signal-boundary/
__pycache__/
*.pyc

# Coverage output from c8. Regenerated by npm run test:coverage; the CI job uploads
# the summary as an artifact rather than committing it.
coverage/

# A dependency tree moved aside by an interrupted or partial npm ci.
node_modules*/

# The bridge is its own npm package, so it carries its own build output and its own
# installed tree. Only its source, tests and manifests belong in this repository.
/bridge/dist/
/bridge/node_modules/

# Ad-hoc PTY diagnostics written while investigating a hanging terminal test: a spawn
# probe, two manual driver loops and the raw TAP dump. Reproducible by hand and not
# part of the suite.
/bridge/probe.mjs
/bridge/ptydll.mjs
/bridge/ptyloop.mjs
/bridge/tapout.txt

# The Build control inventory generator is a maintained audit entrypoint.
!/scripts/build-controls.mjs
/build-test-output.log
/bridge/bridge-test-output.log

/build-browser-output.log
/bridge/bridge-focused-output.log

# Generated MCP/skills awareness reports. These are rewritten on every scan and
# contain machine-specific endpoints, user paths and project identifiers, so they
# stay local. Ignore the awareness report family only; anything else placed under
# .claude/ may be hand-maintained repository configuration and must stay trackable.
.claude/*mcp-skills-awareness*.md
# KNOuX Store MCP Gateway local artifacts
gateway/.venv/
gateway/__pycache__/
gateway/*.pyc

# Generated content exports and local Supabase state; regenerate from the tracked seed tool.
supabase/.temp/
supabase/.seed-batches/
supabase/content-registry.generated.json
supabase/seed.generated.sql
gateway/.venv*/

# Local recovery bundles and snapshots never belong in the product history.
/.knoux-recovery/

# Maintained V4 provenance capture and comparison entrypoints.
!/scripts/visual-v4-capture.mjs
!/scripts/visual-v4-gallery.mjs
